# ── Database (PostgreSQL — Neon or Supabase in production) ──────────────────
# Use the POOLED connection string on Vercel (Neon: "-pooler" host; Supabase: port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/oxyrich?sslmode=require"

# ── Auth.js ────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Needed outside Vercel (Vercel sets it automatically). Must match the public URL.
# AUTH_URL="https://oxyrichpakistan.com.pk"
AUTH_TRUST_HOST="true"

# ── Public site URL (canonical URLs, sitemap, Open Graph, email links) ────
NEXT_PUBLIC_SITE_URL="https://oxyrichpakistan.com.pk"

# ── Email (Resend). If RESEND_API_KEY is empty, emails are logged to the console.
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend.
EMAIL_FROM="Oxyrich Pakistan <orders@oxyrichpakistan.com.pk>"
# Where new-order / enquiry notifications go. Defaults to the business email setting.
ADMIN_NOTIFY_EMAIL="oxyrichpakistan@gmail.com"

# ── Cloudflare Turnstile (bot protection). Leave both empty to disable in dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Analytics ──────────────────────────────────────────────────────────────
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable GA4.
NEXT_PUBLIC_GA_ID=""

# ── Cron (Vercel Cron calls /api/cron/subscriptions with this bearer token) ─
CRON_SECRET=""

# ── Seed: first admin account (used by `npm run db:seed`) ─────────────────
SEED_ADMIN_PHONE="03364448494"
SEED_ADMIN_PASSWORD="change-me-immediately"
SEED_ADMIN_NAME="Oxyrich Admin"
